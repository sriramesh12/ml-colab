function generateMockPricingData(category) {
  const providers = ['AWS', 'Azure', 'GCP'];
  const regions = ['US East', 'US West', 'EU', 'Asia Pacific'];
  const pricingModels = ['On-Demand', 'Reserved 1 Year', 'Reserved 3 Year', 'Spot'];
  
  const mockData = [];

  if (category === 'Compute (VM)') {
    const instances = [
      { name: 't3.medium / B2s / e2-standard-2', vcpu: 2, ram: 4, prices: { AWS: 30.36, Azure: 37.38, GCP: 48.91 } },
      { name: 'm5.large / D2s_v3 / n2-standard-2', vcpu: 2, ram: 8, prices: { AWS: 70.08, Azure: 70.08, GCP: 70.00 } },
      { name: 'c5.xlarge / F4s_v2 / c2-standard-8', vcpu: 4, ram: 8, prices: { AWS: 124.10, Azure: 125.56, GCP: 150.00 } },
      { name: 'r5.xlarge / E4s_v3 / n2-highmem-4', vcpu: 4, ram: 32, prices: { AWS: 183.96, Azure: 183.96, GCP: 280.00 } },
    ];
    
    instances.forEach((inst, idx) => {
      providers.forEach(provider => {
        mockData.push({
          id: `${category}_${provider}_${idx}`,
          category: 'compute',
          provider,
          service: inst.name.split('/')[providers.indexOf(provider)] || inst.name,
          specs: `${inst.vcpu} vCPU, ${inst.ram} GB RAM`,
          vcpu: inst.vcpu,
          ram: inst.ram,
          hourly: inst.prices[provider] / 730,
          monthly: inst.prices[provider],
          annual: inst.prices[provider] * 12,
          pricingModel: 'On-Demand',
          region: 'US East',
          description: 'General purpose virtual machine',
        });
      });
    });
  }

  if (category === 'Serverless') {
    const services = [
      { name: 'Lambda / Functions / Cloud Functions', prices: { AWS: 0.20, Azure: 0.20, GCP: 0.40 }, unit: 'per million requests' },
      { name: 'API Gateway / API Management / API Gateway', prices: { AWS: 3.50, Azure: 3.50, GCP: 3.00 }, unit: 'per million requests' },
    ];
    
    services.forEach((svc, idx) => {
      providers.forEach(provider => {
        mockData.push({
          id: `${category}_${provider}_${idx}`,
          category: 'serverless',
          provider,
          service: svc.name.split('/')[providers.indexOf(provider)] || svc.name,
          specs: svc.unit,
          vcpu: null,
          ram: null,
          hourly: svc.prices[provider] / (730 * 1000000),
          monthly: svc.prices[provider],
          annual: svc.prices[provider] * 12,
          pricingModel: 'Pay-per-use',
          region: 'Global',
          description: 'Serverless compute service',
        });
      });
    });
  }

  if (category === 'Container (K8s)') {
    const services = [
      { name: 'EKS / AKS / GKE', prices: { AWS: 72, Azure: 0, GCP: 72 }, unit: 'cluster management' },
      { name: 'ECR / ACR / GCR', prices: { AWS: 0.10, Azure: 0.10, GCP: 0.10 }, unit: 'per GB stored' },
    ];
    
    services.forEach((svc, idx) => {
      providers.forEach(provider => {
        mockData.push({
          id: `${category}_${provider}_${idx}`,
          category: 'container',
          provider,
          service: svc.name.split('/')[providers.indexOf(provider)] || svc.name,
          specs: svc.unit,
          vcpu: null,
          ram: null,
          hourly: svc.prices[provider] / 730,
          monthly: svc.prices[provider],
          annual: svc.prices[provider] * 12,
          pricingModel: 'Management fee',
          region: 'Global',
          description: 'Managed Kubernetes service',
        });
      });
    });
  }

  if (category === 'Storage') {
    const services = [
      { name: 'S3 Standard / Blob Hot / Cloud Storage Standard', prices: { AWS: 0.023, Azure: 0.021, GCP: 0.020 }, unit: 'per GB' },
      { name: 'S3 Glacier / Blob Cold / Coldline', prices: { AWS: 0.004, Azure: 0.004, GCP: 0.004 }, unit: 'per GB' },
    ];
    
    services.forEach((svc, idx) => {
      providers.forEach(provider => {
        mockData.push({
          id: `${category}_${provider}_${idx}`,
          category: 'storage',
          provider,
          service: svc.name.split('/')[providers.indexOf(provider)] || svc.name,
          specs: svc.unit,
          vcpu: null,
          ram: null,
          hourly: svc.prices[provider] / 730,
          monthly: svc.prices[provider] * 100,
          annual: svc.prices[provider] * 1200,
          pricingModel: 'Usage-based',
          region: 'US East',
          description: 'Object storage service',
        });
      });
    });
  }

  return mockData;
}




