function generateMockPricingData(category) {
  const providers = ['AWS', 'Azure', 'GCP'];
  const regions = ['US East', 'US West', 'EU', 'Asia Pacific'];
  const pricingModels = ['On-Demand', 'Reserved 1 Year', 'Reserved 3 Year', 'Spot'];
  
  const mockData = [];

  if (category === 'Compute (VM)') {
    const instances = [
      { name: 't3.medium / B2s / e2-standard-2', vcpu: 2, ram: 4, prices: { AWS: 30.36, Azure: 37.38, GCP: 48.91 } },
      { name: 'm5.large / D2s_v3 / n2-standard-2', vcpu: 2, ram: 8, prices: { AWS: 70.08, Azure: 70.08, GCP: 70.00 } },
      { name: 'c5.xlarge / F4s_v2 / c2-standard-8', vcpu: 4, ram: 8, prices: { AWS: 124.10, Azure: 125.56, GCP: 150.00 } },
      { name: 'r5.xlarge / E4s_v3 / n2-highmem-4', vcpu: 4, ram: 32, prices: { AWS: 183.96, Azure: 183.96, GCP: 280.00 } },
    ];
    
    instances.forEach((inst, idx) => {
      providers.forEach(provider => {
        mockData.push({
          id: `${category}_${provider}_${idx}`,
