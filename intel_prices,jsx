from pydantic import BaseModel
from typing import Optional, List
import openai
import re

# ============================================================
# Pydantic Models
# ============================================================

class LLMPriceRequest(BaseModel):
    prompt: str
    api_key: str
    provider: str
    category: str
    instance: Optional[str] = None
    region: Optional[str] = None
    pricing_model: Optional[str] = None

class LLMPriceResponse(BaseModel):
    monthly: float
    hourly: float
    raw_response: str
    provider: str
    category: str
    instance: Optional[str] = None

class LLMWorkloadRequest(BaseModel):
    description: str
    api_key: str

class LLMWorkloadResponse(BaseModel):
    recommendations: List[dict]
    totalEstimatedCost: float
    recommendation: str

# ============================================================
# LLM Price Endpoints
# ============================================================

@app.post("/api/llm/get-price")
async def llm_get_price(request: LLMPriceRequest):
    """
    Get pricing using LLM for any cloud service
    """
    try:
        openai.api_key = request.api_key
        
        response = openai.chat.completions.create(
            model="gpt-3.5-turbo",
            messages=[
                {"role": "system", "content": "You are a cloud pricing expert. Extract the monthly price from the given information. Return ONLY a JSON object with 'monthly' and 'hourly' fields."},
                {"role": "user", "content": request.prompt}
            ],
            temperature=0.1,
            max_tokens=200,
            response_format={"type": "json_object"}
        )
        
        result = json.loads(response.choices[0].message.content)
        
        return LLMPriceResponse(
            monthly=result.get("monthly", 0),
            hourly=result.get("hourly", result.get("monthly", 0) / 730),
            raw_response=response.choices[0].message.content,
            provider=request.provider,
            category=request.category,
            instance=request.instance
        )
        
    except Exception as e:
        print(f"LLM Price Error: {str(e)}")
        raise HTTPException(status_code=500, detail=str(e))


