// ============================================================
// MAIN LLM PRICING TAB COMPONENT
// ============================================================
export default function LLMPricingTab({ openaiApiKey }) {
  const [loading, setLoading] = useState(false);
  const [allData, setAllData] = useState([]);
  const [selectedIds, setSelectedIds] = useState(new Set());
  const [activeCategory, setActiveCategory] = useState('Compute (VM)');
  const [filters, setFilters] = useState({
    provider: 'all',
    region: 'all',
    pricingModel: 'all',
    minVcpu: 0,
    maxPrice: 10000,
    search: '',
  });

  const fetchAllPricingData = useCallback(async () => {
    setLoading(true);
    try {
      // Fetch data for all service categories
      const categories = Object.keys(SERVICE_CATEGORIES);
      const allResults = [];

      for (const category of categories) {
        const serviceKey = SERVICE_CATEGORIES[category].serviceKey;
        
        // Simulate API calls for different service types
        // In production, you'd call your backend APIs
        const mockData = generateMockPricingData(category);
        allResults.push(...mockData);
      }

      setAllData(allResults);
    } catch (error) {
      console.error('Error fetching pricing data:', error);
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => {
    fetchAllPricingData();
  }, [fetchAllPricingData]);

  const handleLLMAnalysis = async (description) => {
    setLoading(true);
    try {
      // Call your backend LLM API
      const response = await fetch('/api/llm/analyze-pricing', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ description, apiKey: openaiApiKey }),
      });
      const data = await response.json();
      return data;
    } catch (error) {
      console.error('LLM analysis error:', error);
      return {
        recommendation: 'Unable to analyze at this time. Please try again.',
        provider: 'N/A',
        serviceType: 'N/A',
        estimatedCost: 0,
        confidence: 0,
      };
    } finally {
      setLoading(false);
    }
  };

  const filteredData = useMemo(() => {
    const categoryKey = SERVICE_CATEGORIES[activeCategory].serviceKey;
    let data = allData.filter(item => item.category === categoryKey);

    if (filters.provider !== 'all') {
      data = data.filter(item => item.provider === filters.provider);
    }
    if (filters.region !== 'all') {
      data = data.filter(item => item.region === filters.region);
    }
    if (filters.pricingModel !== 'all') {
      data = data.filter(item => item.pricingModel === filters.pricingModel);
    }
    if (filters.minVcpu > 0) {
      data = data.filter(item => (item.vcpu || 0) >= filters.minVcpu);
    }
    if (filters.maxPrice < 10000) {
      data = data.filter(item => item.monthly <= filters.maxPrice);
    }
    if (filters.search) {
      const searchLower = filters.search.toLowerCase();
      data = data.filter(item => 
        item.service.toLowerCase().includes(searchLower) ||
        item.provider.toLowerCase().includes(searchLower)
      );
    }

    return data;
  }, [allData, activeCategory, filters]);

  const selectedItems = useMemo(() => {
    return allData.filter(item => selectedIds.has(item.id));
  }, [allData, selectedIds]);

  const handleSelect = (id) => {
    const newSet = new Set(selectedIds);
    if (newSet.has(id)) newSet.delete(id);
    else newSet.add(id);
    setSelectedIds(newSet);
  };

  const handleFilterChange = (key, value) => {
    setFilters(prev => ({ ...prev, [key]: value }));
  };

  return (
    <Box sx={{ width: '100%' }}>
      {/* Header */}
      <Box sx={{ mb: 3 }}>
        <Typography variant="h5" gutterBottom>💰 AI-Powered Cloud Price Intelligence</Typography>
        <Typography variant="body2" color="text.secondary">
          Comprehensive price comparison across AWS, Azure, and GCP for all service types.
          Use AI to get intelligent recommendations based on your workload requirements.
        </Typography>
      </Box>

      {/* LLM Analysis Section */}
      <LLMPricingAnalyzer openaiApiKey={openaiApiKey} onAnalyze={handleLLMAnalysis} loading={loading} />

      {/* Service Category Tabs */}
      <Paper sx={{ mb: 3 }}>
        <Tabs
          value={activeCategory}
          onChange={(e, v) => setActiveCategory(v)}
          variant="scrollable"
          scrollButtons="auto"
          sx={{ borderBottom: 1, borderColor: 'divider' }}
        >
          {Object.entries(SERVICE_CATEGORIES).map(([name, config]) => (
            <Tab
              key={name}
              label={
                <Box sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                  {config.icon}
                  <span>{name}</span>
                </Box>
              }
              value={name}
            />
          ))}
        </Tabs>
      </Paper>

      {/* Filters */}
      <PricingFilters filters={filters} onFilterChange={handleFilterChange} />

      {/* Comparison View (if items selected) */}
      <ComparisonView selectedItems={selectedItems} />

      {/* Main Pricing Table */}
      <ServicePricingTable
        title={`${activeCategory} Pricing (${filteredData.length} services)`}
        data={filteredData}
        loading={loading}
        onSelect={handleSelect}
        selectedIds={selectedIds}
        onCompare={() => {}}
      />

      {/* Insights Section */}
      <Paper sx={{ p: 2, mt: 3, bgcolor: '#e8f5e9' }}>
        <Typography variant="subtitle2" gutterBottom>💡 Price Insights</Typography>
        <Grid container spacing={2}>
          <Grid item xs={12} md={4}>
            <Typography variant="caption" color="text.secondary">Cheapest Provider</Typography>
            <Typography variant="body1" fontWeight="bold">
              {filteredData.length > 0 ? 
                filteredData.reduce((a, b) => a.monthly < b.monthly ? a : b).provider : 'N/A'}
            </Typography>
          </Grid>
          <Grid item xs={12} md={4}>
            <Typography variant="caption" color="text.secondary">Average Monthly Cost</Typography>
            <Typography variant="body1" fontWeight="bold">
              {filteredData.length > 0 ? 
                fmt(filteredData.reduce((s, i) => s + i.monthly, 0) / filteredData.length) : 'N/A'}
            </Typography>
          </Grid>
          <Grid item xs={12} md={4}>
            <Typography variant="caption" color="text.secondary">Price Range</Typography>
            <Typography variant="body1" fontWeight="bold">
              {filteredData.length > 0 ? 
                `${fmt(Math.min(...filteredData.map(i => i.monthly))} - ${fmt(Math.max(...filteredData.map(i => i.monthly)))}` : 'N/A'}
            </Typography>
          </Grid>
        </Grid>
      </Paper>
    </Box>
  );
}

