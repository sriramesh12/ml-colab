  const [savedResults, setSavedResults] = useState([]);

  const handlePriceFetched = (category, provider, data) => {
    setPrices(prev => ({
      ...prev,
      [`${category}_${provider}`]: data
    }));
  };

  const handleSaveResult = () => {
    if (Object.keys(prices).length > 0) {
      setSavedResults(prev => [...prev, {
        id: Date.now(),
        timestamp: new Date().toISOString(),
        prices: { ...prices }
      }]);
    }
  };

  const exportToCSV = () => {
    const results = Object.entries(prices).map(([key, value]) => ({
      'Service': key,
      'Provider': key.split('_')[1],
      'Category': key.split('_')[0],
      'Monthly Cost': value?.monthly || 0,
      'Hourly Cost': value?.hourly || 0,
    }));
    
    if (results.length === 0) return;
    
    const headers = Object.keys(results[0]);
    let csv = headers.join(',') + '\n';
    results.forEach(row => {
      csv += headers.map(h => `"${row[h]}"`).join(',') + '\n';
    });
    
    const blob = new Blob([csv], { type: 'text/csv' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `llm_prices_${new Date().toISOString().slice(0, 19)}.csv`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
