function LLMPriceFetcher({ openaiApiKey, category, onPriceFetched, isActive }) {
  const [provider, setProvider] = useState('AWS');
  const [instance, setInstance] = useState(INSTANCE_TYPES.AWS[0]);
  const [region, setRegion] = useState('US East');
  const [pricingModel, setPricingModel] = useState('On-Demand');
  const [loading, setLoading] = useState(false);
  const [priceData, setPriceData] = useState(null);
  const [error, setError] = useState('');

  const instances = INSTANCE_TYPES[provider] || INSTANCE_TYPES.AWS;
  const regionCode = REGION_MAP[region]?.[provider] || 'us-east-1';

  const fetchPrice = async () => {
    setLoading(true);
    setError('');
    setPriceData(null);

    try {
      let prompt = '';
      
      if (category === 'compute') {
        prompt = PRICING_QUERY_PROMPTS.compute
          .replace('{instance}', instance)
          .replace('{region}', regionCode)
          .replace('{provider}', provider)
          .replace('{pricingModel}', pricingModel);
      } else if (category === 'serverless') {
        prompt = PRICING_QUERY_PROMPTS.serverless.replace('{provider}', provider);
      } else if (category === 'container') {
        prompt = PRICING_QUERY_PROMPTS.container
          .replace('{provider}', provider)
          .replace('{region}', regionCode);
      } else if (category === 'storage') {
        prompt = PRICING_QUERY_PROMPTS.storage
          .replace('{provider}', provider)
          .replace('{region}', regionCode);
      } else if (category === 'database') {
        prompt = PRICING_QUERY_PROMPTS.database
          .replace('{provider}', provider)
          .replace('{region}', regionCode);
      }

      const response = await fetch('/api/llm/get-price', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          prompt,
          api_key: openaiApiKey,
          provider,
          category,
          instance: category === 'compute' ? instance : null,
          region: regionCode,
          pricing_model: pricingModel,
        }),
      });

      if (!response.ok) throw new Error(`API error: ${response.status}`);
      
      const result = await response.json();
      setPriceData(result);
      if (onPriceFetched) onPriceFetched(category, provider, result);
    } catch (err) {
      setError(err.message);
    } finally {
      setLoading(false);
    }
  };

  if (!isActive) return null;

  return (
    <Box>
      <Grid container spacing={2} sx={{ mb: 3 }}>
        <Grid item xs={12} sm={6} md={3}>
          <TextField
            select fullWidth size="small" label="Provider"
            value={provider} onChange={(e) => setProvider(e.target.value)}
          >
            {PROVIDERS.map(p => <MenuItem key={p} value={p}>{p}</MenuItem>)}
          </TextField>
        </Grid>
        
        {category === 'compute' && (
          <>
            <Grid item xs={12} sm={6} md={3}>
              <TextField
                select fullWidth size="small" label="Instance Type"
                value={instance} onChange={(e) => setInstance(e.target.value)}
              >
                {instances.map(i => <MenuItem key={i} value={i}>{i}</MenuItem>)}
              </TextField>
            </Grid>
            <Grid item xs={12} sm={6} md={2}>
              <TextField
                select fullWidth size="small" label="Pricing Model"
                value={pricingModel} onChange={(e) => setPricingModel(e.target.value)}
              >
                {PRICING_MODELS.map(pm => <MenuItem key={pm} value={pm}>{pm}</MenuItem>)}
              </TextField>
            </Grid>
          </>
        )}
        
        <Grid item xs={12} sm={6} md={category === 'compute' ? 2 : 3}>
          <TextField
            select fullWidth size="small" label="Region"
            value={region} onChange={(e) => setRegion(e.target.value)}
          >
            {Object.keys(REGION_MAP).map(r => <MenuItem key={r} value={r}>{r}</MenuItem>)}
          </TextField>
        </Grid>
        
        <Grid item xs={12} sm={6} md={category === 'compute' ? 2 : 3}>
          <Button
            fullWidth variant="contained" onClick={fetchPrice}
            disabled={loading} startIcon={loading ? <CircularProgress size={16} /> : <SmartToyIcon />}
          >
            {loading ? 'Fetching...' : 'Get LLM Price'}
          </Button>
        </Grid>
      </Grid>

      {error && <Alert severity="error" sx={{ mb: 2 }}>{error}</Alert>}

      {priceData && (
        <Card sx={{ mb: 3, bgcolor: '#e3f2fd' }}>
          <CardContent>
            <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start' }}>
              <Typography variant="subtitle2" gutterBottom color="primary">
                🤖 LLM Price Analysis for {provider} {category}
              </Typography>
              <IconButton size="small" onClick={() => navigator.clipboard.writeText(JSON.stringify(priceData, null, 2))}>
                <ContentCopyIcon fontSize="small" />
              </IconButton>
            </Box>
            <Grid container spacing={2}>
              <Grid item xs={6} sm={3}>
                <MetricCard label="Provider" value={provider} color="info" />
              </Grid>
              {category === 'compute' && (
                <Grid item xs={6} sm={3}>
                  <MetricCard label="Instance" value={instance} color="info" />
                </Grid>
              )}
              <Grid item xs={6} sm={3}>
                <MetricCard label="Monthly Cost" value={fmt(priceData.monthly)} color="success" />
              </Grid>
              <Grid item xs={6} sm={3}>
