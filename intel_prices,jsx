// ============================================================
// LLM PRICING ANALYZER COMPONENT
// ============================================================
function LLMPricingAnalyzer({ openaiApiKey, onAnalyze, loading }) {
  const [workloadDescription, setWorkloadDescription] = useState('');
  const [analysisResult, setAnalysisResult] = useState(null);

  const handleAnalyze = async () => {
    if (!workloadDescription.trim()) return;
    const result = await onAnalyze(workloadDescription);
    setAnalysisResult(result);
  };

  return (
    <Card sx={{ mb: 3, bgcolor: '#f5f5f5' }}>
      <CardContent>
        <Box sx={{ display: 'flex', alignItems: 'center', mb: 2 }}>
          <SmartToyIcon sx={{ mr: 1, color: '#9c27b0' }} />
          <Typography variant="h6">AI Price Intelligence</Typography>
          <Chip label="Powered by LLM" size="small" sx={{ ml: 2 }} />
        </Box>
        <Typography variant="body2" color="text.secondary" sx={{ mb: 2 }}>
          Describe your workload in plain English, and our AI will recommend the most cost-effective cloud services across providers.
        </Typography>
        <Grid container spacing={2}>
          <Grid item xs={12} md={9}>
            <TextField
              fullWidth
              multiline
              rows={3}
              placeholder="Example: I need a production web application serving 100k users monthly, with a PostgreSQL database, using containerized microservices. Expected to run 24/7."
              value={workloadDescription}
              onChange={(e) => setWorkloadDescription(e.target.value)}
              sx={{ bgcolor: 'white' }}
            />
          </Grid>
          <Grid item xs={12} md={3}>
            <Button
              fullWidth
              variant="contained"
              startIcon={loading ? <CircularProgress size={20} /> : <SmartToyIcon />}
              onClick={handleAnalyze}
              disabled={loading || !workloadDescription.trim()}
              sx={{ height: '100%', minHeight: 80 }}
            >
              {loading ? 'Analyzing...' : 'AI Analysis'}
            </Button>
          </Grid>
        </Grid>

        {analysisResult && (
          <Box sx={{ mt: 2, p: 2, bgcolor: '#e3f2fd', borderRadius: 1 }}>
            <Typography variant="subtitle2" gutterBottom>🤖 AI Recommendation</Typography>
            <Typography variant="body2">{analysisResult.recommendation}</Typography>
            <Grid container spacing={2} sx={{ mt: 1 }}>
              <Grid item xs={6} sm={3}>
                <Typography variant="caption" color="text.secondary">Recommended Provider</Typography>
                <Typography variant="body1" fontWeight="bold">{analysisResult.provider}</Typography>
              </Grid>
              <Grid item xs={6} sm={3}>
                <Typography variant="caption" color="text.secondary">Service Type</Typography>
                <Typography variant="body1" fontWeight="bold">{analysisResult.serviceType}</Typography>
              </Grid>
              <Grid item xs={6} sm={3}>
                <Typography variant="caption" color="text.secondary">Estimated Monthly</Typography>
                <Typography variant="body1" fontWeight="bold">{fmt(analysisResult.estimatedCost)}</Typography>
              </Grid>
              <Grid item xs={6} sm={3}>
                <Typography variant="caption" color="text.secondary">Confidence</Typography>
                <Typography variant="body1" fontWeight="bold">{analysisResult.confidence}%</Typography>
              </Grid>
            </Grid>
          </Box>
        )}
      </CardContent>
    </Card>
  );
}

// ============================================================
// SERVICE PRICING TABLE
