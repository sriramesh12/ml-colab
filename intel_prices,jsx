          provider,
          service: svc.name.split('/')[providers.indexOf(provider)] || svc.name,
          specs: svc.unit,
          vcpu: null,
          ram: null,
          hourly: svc.prices[provider] / 730,
          monthly: svc.prices[provider],
          annual: svc.prices[provider] * 12,
          pricingModel: 'Management fee',
          region: 'Global',
          description: 'Managed Kubernetes service',
        });
      });
    });
  }

  if (category === 'Storage') {
    const services = [
      { name: 'S3 Standard / Blob Hot / Cloud Storage Standard', prices: { AWS: 0.023, Azure: 0.021, GCP: 0.020 }, unit: 'per GB' },
      { name: 'S3 Glacier / Blob Cold / Coldline', prices: { AWS: 0.004, Azure: 0.004, GCP: 0.004 }, unit: 'per GB' },
