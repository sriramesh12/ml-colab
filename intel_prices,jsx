function ServicePricingTable({ title, data, loading, onSelect, selectedIds, onCompare }) {
  const columns = [
    { field: 'select', headerName: '', width: 50, renderCell: (params) => (
      <Checkbox size="small" checked={selectedIds.has(params.row.id)} onChange={() => onSelect(params.row.id)} />
    )},
    { field: 'provider', headerName: 'Provider', width: 90, renderCell: (params) => (
      <Chip label={params.value} size="small" color={params.value === 'AWS' ? 'primary' : params.value === 'Azure' ? 'info' : 'default'} />
    )},
    { field: 'service', headerName: 'Service', width: 150, renderCell: (params) => (
      <Tooltip title={params.row.description || ''}>
        <span>{params.value}</span>
      </Tooltip>
    )},
    { field: 'specs', headerName: 'Specifications', width: 200 },
    { field: 'hourly', headerName: 'Hourly', width: 90, valueFormatter: ({ value }) => value ? fmt(value) : '-' },
    { field: 'monthly', headerName: 'Monthly', width: 100, valueFormatter: ({ value }) => fmt(value) },
    { field: 'annual', headerName: 'Annual', width: 100, valueFormatter: ({ value }) => fmt(value || 0) },
    { field: 'pricingModel', headerName: 'Pricing Model', width: 120 },
    { field: 'region', headerName: 'Region', width: 120 },
  ];

  return (
    <Paper sx={{ p: 2, mb: 3 }}>
      <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', mb: 2 }}>
        <Typography variant="subtitle1" fontWeight="bold">{title}</Typography>
        <Box>
          {selectedIds.size > 0 && (
            <Button size="small" variant="outlined" onClick={onCompare} startIcon={<CompareArrowsIcon />}>
              Compare ({selectedIds.size})
            </Button>
          )}
          <Button size="small" startIcon={<FileDownloadIcon />} sx={{ ml: 1 }}>
            Export
          </Button>
        </Box>
      </Box>
      <Box sx={{ height: 400, width: '100%' }}>
        <DataGrid
          rows={data}
          columns={columns}
          loading={loading}
          disableSelectionOnClick
          checkboxSelection={false}
          sx={{ fontSize: '0.75rem' }}
        />
      </Box>
    </Paper>
  );
}

// ============================================================
// COMPARISON VIEW
// ============================================================
function ComparisonView({ selectedItems }) {
  if (selectedItems.length === 0) return null;

  const barData = [{
    type: 'bar',
    x: selectedItems.map(i => `${i.provider}\n${i.service}`),
    y: selectedItems.map(i => i.monthly),
    text: selectedItems.map(i => fmt(i.monthly)),
    textposition: 'outside',
    marker: { color: selectedItems.map(i => i.provider === 'AWS' ? '#ff9900' : i.provider === 'Azure' ? '#0078d4' : '#4285f4') },
  }];

  return (
    <Card sx={{ mb: 3 }}>
      <CardContent>
        <Typography variant="h6" gutterBottom>📊 Service Comparison</Typography>
        <Grid container spacing={2}>
          <Grid item xs={12} md={6}>
            <Plot data={barData} layout={{ title: 'Monthly Cost Comparison', height: 350 }} config={{ displayModeBar: false }} style={{ width: '100%' }} />
          </Grid>
          <Grid item xs={12} md={6}>
            <TableContainer component={Paper} variant="outlined">
              <Table size="small">
                <TableHead>
                  <TableRow sx={{ bgcolor: '#f5f5f5' }}>
                    <TableCell>Provider</TableCell>
                    <TableCell>Service</TableCell>
                    <TableCell align="right">Monthly</TableCell>
                    <TableCell align="right">Annual</TableCell>
                  </TableRow>
                </TableHead>
                <TableBody>
                  {selectedItems.map((item, idx) => (
                    <TableRow key={idx}>
                      <TableCell>{item.provider}</TableCell>
                      <TableCell>{item.service}</TableCell>
                      <TableCell align="right">{fmt(item.monthly)}</TableCell>
                      <TableCell align="right">{fmt(item.annual || item.monthly * 12)}</TableCell>
                    </TableRow>
                  ))}
                  <TableRow sx={{ bgcolor: '#e8f5e9' }}>
                    <TableCell colSpan={2}><strong>Total</strong></TableCell>
                    <TableCell align="right"><strong>{fmt(selectedItems.reduce((s, i) => s + i.monthly, 0))}</strong></TableCell>
                    <TableCell align="right"><strong>{fmt(selectedItems.reduce((s, i) => s + (i.annual || i.monthly * 12), 0))}</strong></TableCell>
                  </TableRow>
                </TableBody>
              </Table>
            </TableContainer>
          </Grid>
        </Grid>
      </CardContent>
    </Card>
  );
}

